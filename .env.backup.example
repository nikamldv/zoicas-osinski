# Copy to .env.backup and fill in locally. Do not commit .env.backup.
# Use a MySQL account with SELECT, SHOW VIEW, TRIGGER, EVENT and LOCK TABLES
# privileges for the configured database. Recovery additionally needs CREATE.
MYSQL_BACKUP_HOST=127.0.0.1
MYSQL_BACKUP_PORT=3306
MYSQL_BACKUP_USER=replace_with_dedicated_backup_user
MYSQL_BACKUP_PASSWORD=replace_locally_only
MYSQL_BACKUP_DATABASE=zoicas_osinski
BACKUP_DIRECTORY=storage/database-backups
BACKUP_RETENTION_DAYS=30
BACKUP_INCLUDE_EVENTS=true
# Must stay false until a reviewed production retention policy is approved.
BACKUP_RETENTION_DELETE_APPROVED=false
MYSQL_BIN_DIR=C:\Program Files\MySQL\MySQL Server 8.0\bin
