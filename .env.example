# Copy this file to .env and enter your private MySQL connection values.
HOST=127.0.0.1
PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=zoicas_app
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_DATABASE=zoicas_osinski
MYSQL_SSL=false
# Optional: absolute path to the trusted CA certificate when MYSQL_SSL=true
# MYSQL_SSL_CA=C:/path/to/mysql-ca.pem
MYSQL_CONNECTION_LIMIT=10

# Dashboard login. Generate the password hash with: npm run admin:hash
ADMIN_USERNAME=site-admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_MINUTES=480
# On IONOS/HTTPS set COOKIE_SECURE=true. For local HTTP leave this blank or set false.
COOKIE_SECURE=

# Customer portal session; leave blank to use the safe default of 8 hours.
CUSTOMER_SESSION_TTL_MINUTES=480

# Separate MySQL account for the private dashboard (SELECT/UPDATE only).
MYSQL_ADMIN_USER=zoicas_dashboard
MYSQL_ADMIN_PASSWORD=replace_with_a_different_long_random_password

# Quote request uploads (kept outside all public static folders)
QUOTE_UPLOAD_DIR=storage/quote-uploads
QUOTE_MAX_FILE_BYTES=5242880
QUOTE_MAX_FILES=5

# Online booking: set only confirmed business hours here. Comma-separated HH:MM start times.
# Leave blank until the company has confirmed bookable time windows.
BOOKING_SLOT_TIMES=
BOOKING_SLOT_DURATION_MINUTES=60

# Optional future SMTP configuration. Email delivery is intentionally disabled until set up.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=
