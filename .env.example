# Copy this file to .env and enter your private MySQL connection values.
HOST=127.0.0.1
PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=zoicas_app
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_DATABASE=zoicas_osinski
MYSQL_SSL=false
# Optional: absolute path to the trusted CA certificate when MYSQL_SSL=true
# MYSQL_SSL_CA=C:/path/to/mysql-ca.pem
MYSQL_CONNECTION_LIMIT=10
