# Production configuration template. Copy locally to .env.production; never commit it.
# The application rejects an unsafe production configuration during startup.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Public HTTPS origin only. Do not add a path or trailing slash.
PUBLIC_BASE_URL=https://www.example.de
# Comma-separated browser origins allowed to issue state-changing requests.
TRUSTED_ORIGINS=https://www.example.de,https://example.de
# The Node service must remain behind an HTTPS reverse proxy.
TRUST_PROXY=true
COOKIE_SECURE=true
# Enable only after HTTPS is verified at the public domain.
ENABLE_HSTS=true
# Optional: leave blank to use the application's compatible default policy.
# CONTENT_SECURITY_POLICY=

# Application database account: least privilege, no schema privileges.
MYSQL_HOST=database-host.example
MYSQL_PORT=3306
MYSQL_USER=replace_with_application_account
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_DATABASE=zoicas_osinski
MYSQL_SSL=true
# Use the host-provided CA when it is not already trusted by the operating system.
# MYSQL_SSL_CA=C:/secure-path/mysql-ca.pem
MYSQL_CONNECTION_LIMIT=10

# Separate dashboard account. Do not use a MySQL administrator account here.
MYSQL_ADMIN_USER=replace_with_dashboard_account
MYSQL_ADMIN_PASSWORD=replace_with_a_different_long_random_password

# Admin credentials: store only a generated password hash.
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD_HASH=scrypt$replace_with_32_hex_character_salt$replace_with_128_hex_character_hash
ADMIN_SESSION_TTL_MINUTES=480
CUSTOMER_SESSION_TTL_MINUTES=480
EMPLOYEE_SESSION_TTL_MINUTES=480

# Private storage remains outside public static directories.
QUOTE_UPLOAD_DIR=storage/quote-uploads
EMPLOYEE_UPLOAD_DIR=storage/employee-documents
PRIVATE_DOCUMENT_UPLOAD_DIR=storage/private-documents

# Configure SMTP only with a dedicated production mailbox over TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_IMPLICIT_TLS=false
ADMIN_NOTIFICATION_EMAIL=
