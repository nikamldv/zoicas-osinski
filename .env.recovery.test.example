# Copy to .env.recovery.test locally only. This is for isolated recovery tests.
# Use an authorized recovery administrator; never use the application account.
MYSQL_RECOVERY_HOST=127.0.0.1
MYSQL_RECOVERY_PORT=3306
MYSQL_RECOVERY_USER=replace_with_recovery_administrator
MYSQL_RECOVERY_PASSWORD=replace_locally_only
MYSQL_BIN_DIR=C:\Program Files\MySQL\MySQL Server 8.0\bin
